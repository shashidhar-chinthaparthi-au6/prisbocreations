# =============================================================================
# REQUIRED — app will not run correctly without these
# =============================================================================
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/prisbocreations?retryWrites=true&w=majority

# Min 16 characters. Used for admin JWT cookie AND for Auth.js (storefront) unless AUTH_SECRET is set.
JWT_SECRET=change-me-to-a-long-random-string

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# Public URL of the site (password-reset links, emails). Use your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Auth.js (storefront) — optional overrides
# =============================================================================
# Optional separate secret for customer sessions only (min 16). If unset, JWT_SECRET is used.
# AUTH_SECRET=

# Production: canonical origin Auth.js should trust (e.g. https://www.yoursite.com). Often set on Vercel automatically.
# AUTH_URL=https://www.example.com

# Legacy name; prefer AUTH_SECRET. If unset, JWT_SECRET / AUTH_SECRET apply.
# NEXTAUTH_SECRET=

# Set to true to send reset/welcome mail via SES. If false or unset, auth emails are logged to the server console.
# EMAIL_ENABLED=true

# =============================================================================
# Optional — seed script / admin bootstrap
# =============================================================================
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Session lifetime in seconds (default 604800 = 7 days). Must match cookie max-age and JWT exp.
# SESSION_MAX_AGE_SECONDS=604800

# =============================================================================
# Optional — S3 presigned uploads (admin)
# =============================================================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=your-bucket
# S3_PUBLIC_BASE_URL=https://your-cdn.example.com
# NEXT_PUBLIC_S3_PUBLIC_URL=https://your-cdn.example.com
#
# Bucket CORS (S3 → bucket → Permissions → CORS): allow browser PUT from each origin you use, e.g.
#   "AllowedOrigins": ["https://your-domain.com","http://localhost:3000"]
# plus "AllowedMethods": ["GET","PUT","HEAD"], "AllowedHeaders": ["*"].

# =============================================================================
# Optional — Shiprocket (https://www.shiprocket.in/)
# =============================================================================
# SHIPROCKET_BEARER_TOKEN=eyJ...
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_LOCATION=Primary Warehouse
# SHIPROCKET_PICKUP_PINCODE=110001
# SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
# SHIPROCKET_DEFAULT_LENGTH_CM=20
# SHIPROCKET_DEFAULT_BREADTH_CM=15
# SHIPROCKET_DEFAULT_HEIGHT_CM=5
# SHIPROCKET_WEBHOOK_SECRET=generate-a-long-random-string
# Panel webhook URL → POST /api/v1/webhooks/courier-tracking (token sent as x-api-key)
# Subaccount TSP metadata only — do not use for External API auth:
# SHIPROCKET_TSP_USERNAME=
# SHIPROCKET_TSP_API_KEY_NAME=
# SHIPROCKET_TSP_API_KEY=

# Cart subtotal (rupees) at or above this gets free delivery when Shiprocket quotes apply.
# FREE_DELIVERY_THRESHOLD=1499

# =============================================================================
# Optional — Email (Amazon SES) & SMS (Msg91)
# =============================================================================
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=noreply@yourdomain.com
# SES_FROM_NAME=Prisbo Creations
# STORE_OWNER_EMAIL=you@example.com
# EMAIL_ENABLED=true
# SMS_ENABLED=true
# MSG91_AUTHKEY=
# MSG91_TEMPLATE_ORDER_PLACED=
# MSG91_TEMPLATE_ORDER_PAID=
# MSG91_TEMPLATE_ORDER_CANCELLED=
# MSG91_TEMPLATE_ORDER_SHIPPED=
# MSG91_TEMPLATE_ORDER_TRACKING=
# MSG91_SHORT_URL_DEFAULT=0

# Track page + emails (optional)
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com

# Cloudflare Turnstile (recommended for POST /api/track/by-contact after failed lookups)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# GSTIN on PDF invoices (optional)
# SELLER_GSTIN=
# NEXT_PUBLIC_SELLER_GSTIN=

# =============================================================================
# Analytics (all optional — leave blank to disable)
# =============================================================================
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook) Pixel ID
# NEXT_PUBLIC_META_PIXEL_ID=
# Microsoft Clarity Project ID
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
